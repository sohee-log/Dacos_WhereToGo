# roleB 환경변수 예시. 실제 값이 든 .env는 커밋하지 않는다.
# 레포가 public이므로 예외가 없다 (PLAN.md §11.4).
# prod 값은 Render 대시보드 환경변수에만 넣는다.

# --- 동작 모드 -------------------------------------------------------------
# W1은 true. DB가 붙는 W2에 false로 내린다.
MOCK_MODE=true

# --- CORS ------------------------------------------------------------------
# prod에서는 Vercel 도메인만 남긴다. * 는 쓰지 않는다.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://dacos-wheretogo-web.vercel.app

# --- DB (W2~) --------------------------------------------------------------
# Supabase > Project Settings > Database > Connection string (URI)
# DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# --- 후보 필터 임계값 (전환기에만 만진다) ----------------------------------
# 기본값은 설계값(0.30 / 0.15)이다. 평상시 건드릴 이유가 없다.
#
# A의 LLM 속성 추출(A3-2/A4-1) 전에는 poi.attr_confidence가 전 건 0이라
# 0.30 기준으로는 후보가 한 건도 안 남고, 최근접 폴백까지 밀려
# **순위 없는 3건**이 나간다. 화면을 먼저 봐야 하면 아래를 0으로 내리고,
# 추출이 끝나면 되돌린다. 코드 수정·재배포가 필요 없다.
#
# 지금 상태를 먼저 확인하려면:  python -m tools.check_data_readiness
# ATTR_CONFIDENCE_MIN=0.30
# ATTR_CONFIDENCE_RELAXED=0.15

# --- 목 데이터 (W1) --------------------------------------------------------
# A가 seeds/poi_seed.json을 커밋하면 자동으로 그쪽을 읽는다. 없으면 내장 픽스처.
SEED_PATH=../seeds/poi_seed.json
# 목 응답 날씨 고정. 맑음 / 비 / 미세먼지나쁨 / 폭염한파 (비우면 방문일자로 자동 결정)
# MOCK_WEATHER_STATE=비

# --- 외부 API (W3~) --------------------------------------------------------
# SEOUL_CITYDATA_KEY=
# KMA_SERVICE_KEY=

# --- LLM (W5~) -------------------------------------------------------------
# 게이트웨이는 OpenAI Chat Completions 호환. 경로에 끝 슬래시가 필요하다.
# 키는 여기 적지 않는다 — 로컬은 .env, prod는 Render 환경변수. (실측치: docs/LLM_QUOTA.md)
# LLM_API_KEY=
LLM_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
LLM_MODEL=gemini-3.5-flash-lite
# true로 두면 LLM 호출을 강제 실패시킨다. 템플릿 폴백 테스트(B5-5)용.
LLM_FORCE_FAIL=false
