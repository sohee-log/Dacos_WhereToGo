# roleB 환경변수 예시. 실제 값이 든 .env는 커밋하지 않는다.
# 레포가 public이므로 예외가 없다 (PLAN.md §11.4).
# prod 값은 Render 대시보드 환경변수에만 넣는다.

# --- 동작 모드 -------------------------------------------------------------
# W1은 true. DB가 붙는 W2에 false로 내린다.
MOCK_MODE=true

# --- CORS ------------------------------------------------------------------
# prod에서는 Vercel 도메인만 남긴다. * 는 쓰지 않는다.
CORS_ORIGINS=http://localhost:3000,https://<프로젝트>.vercel.app

# --- DB (W2~) --------------------------------------------------------------
# Supabase > Project Settings > Database > Connection string (URI)
# DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# --- 목 데이터 (W1) --------------------------------------------------------
# A가 seeds/poi_seed.json을 커밋하면 자동으로 그쪽을 읽는다. 없으면 내장 픽스처.
SEED_PATH=../seeds/poi_seed.json
# 목 응답 날씨 고정. 맑음 / 비 / 미세먼지나쁨 / 폭염한파 (비우면 방문일자로 자동 결정)
# MOCK_WEATHER_STATE=비

# --- 외부 API (W3~) --------------------------------------------------------
# SEOUL_CITYDATA_KEY=
# KMA_SERVICE_KEY=

# --- LLM (W5~) -------------------------------------------------------------
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
# true로 두면 LLM 호출을 강제 실패시킨다. 템플릿 폴백 테스트(B5-5)용.
LLM_FORCE_FAIL=false
